# TradePulse database connections (Neon PostgreSQL).
# Copy this file to .env and replace the placeholders with the values from the
# Neon dashboard. Never commit the populated .env file.
#
# Runtime queries use the pooled endpoint (hostname contains "-pooler"). In
# production, use a least-privilege runtime role, not the database owner.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Prisma CLI, migrations, and the seed script use the direct endpoint
# (hostname without "-pooler"). Keep the owner/direct credential in a trusted
# migration environment. Vercel only needs a non-owner placeholder for
# `prisma generate`; never store the owner credential there.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional: only needed for `prisma migrate dev` (development drift detection).
# Use a separate Neon branch or database, never the pooled endpoint, and never
# point this at the production branch.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb_shadow?sslmode=require&channel_binding=require"

# Authentication tuning. Every value has a bounded server-side default; these
# are shown with their defaults and are optional.
# AUTH_OTP_TTL_SECONDS="300"
# AUTH_OTP_MAX_ATTEMPTS="5"
# AUTH_OTP_RESEND_COOLDOWN_SECONDS="60"
# AUTH_OTP_RESERVATION_LEASE_SECONDS="60"
# AUTH_OTP_RATE_WINDOW_MINUTES="15"
# AUTH_OTP_MAX_REQUESTS_PER_WINDOW="5"
# AUTH_OTP_MAX_REQUESTS_PER_IP_WINDOW="20"
# AUTH_SESSION_TTL_DAYS="7"

# Development target verification. Development OTP and
# `npm run db:provision-dev` fail closed unless the effective runtime
# DATABASE_URL target is explicitly allowlisted and its fingerprint matches.
# DIRECT_URL, when present, must resolve to the same host, port, database, and
# schema; target-override PG* variables are rejected.
#
# Run `npm run db:dev-target` to print the runtime host, port, database, schema,
# and fingerprint. The command prints no credentials, query parameters, or raw
# URL. The fingerprint covers `<host>/<port>/<database>/<schema>`; only Neon
# `-pooler` hostnames are normalized.
#
# Never set these on a public deployment or point them at production.
# TRADEPULSE_DEV_TARGET_HOSTS="ep-xxxx.ap-southeast-1.aws.neon.tech"
# TRADEPULSE_DEV_TARGET_FINGERPRINT="<64 lowercase hex characters>"

# Optional: known production hosts that must always fail the development-target
# guard, even if they were accidentally added to the allowlist.
# TRADEPULSE_PRODUCTION_TARGET_HOSTS="ep-production-xxxx.ap-southeast-1.aws.neon.tech"

# Development-only OTP delivery. When enabled outside production and the
# database target passes the development-target guard above, the generated code
# is returned to the local UI. This flag is ignored in production even if it is
# set, and the server action independently suppresses the code. Never enable it
# on a public deployment, and never point local development at the production
# database branch.
# AUTH_DEV_OTP_ENABLED="false"

# Development-only account provisioning guard. Required by
# `npm run db:provision-dev`, which also requires the verified development
# target and refuses to run in production.
# AUTH_DEV_PROVISIONING_ENABLED="false"

# Explicit first-administrator bootstrap for a new environment. Required by
# `npm run db:bootstrap-admin`. This is a trusted CLI operation, never an HTTP
# route. The script refuses to run when an active administrator already exists,
# revokes existing sessions when promoting an existing user, prints only the
# last four phone digits, and never creates an OTP or issues a new session.
# Unset it immediately after use.
# AUTH_BOOTSTRAP_ADMIN_ENABLED="false"

# Integration tests only. Explicit disposable PostgreSQL admin URL used by
# `npm run test:integration`; it never falls back to DATABASE_URL or DIRECT_URL.
# The `neondb` production database name and any target matching a configured
# production URL are rejected for every server. A Neon target is accepted only
# when it points at the exact `tradepulse_test` database, uses the direct
# endpoint, and matches the non-secret allowlist below. The harness creates and
# drops only its own generated tradepulse_test_* databases and never drops
# tradepulse_test itself. Set these in the test shell, not in the application .env.
# Validate them with `npm run db:test-target` before `npm run test:integration`.
# TRADEPULSE_TEST_DATABASE_ADMIN_URL="postgresql://test_admin:password@127.0.0.1:5432/postgres?sslmode=disable"
#
# For a Neon test database, use the direct (non-pooled) connection string and
# set the endpoint hostname without a scheme, port, or credentials.
# TRADEPULSE_TEST_DATABASE_EXPECTED_NEON_HOST="ep-example-123.ap-southeast-1.aws.neon.tech"
#
# A Neon comparison requires DATABASE_URL/DIRECT_URL to point at a `neondb`
# target, or this explicit non-secret fingerprint list. Comma-separated SHA-256.
# TRADEPULSE_PRODUCTION_TARGET_FINGERPRINTS="<64-hex>,<64-hex>"
#
# Optional: mark the production endpoint as denied even when the database name
# differs. `tradepulse_test` may intentionally share the existing project's
# endpoint; set this when a separate Neon project or branch is required.
# TRADEPULSE_PRODUCTION_TARGET_HOSTS="ep-production-xxxx.ap-southeast-1.aws.neon.tech"

# SMS OTP delivery. Production requires one complete provider configuration;
# otherwise OTP requests fail closed. TradePulse always generates, hashes, and
# verifies the code locally; the provider only delivers it. Never commit real
# credentials. Run `npm run auth:sms-check` in a trusted environment after
# configuration; it prints no secret values and rejects these example
# placeholders, but it does not prove provider authentication or DLT approval.
#
# Outside production, a verified AUTH_DEV_OTP_ENABLED development target takes
# precedence over SMS so local work never sends real texts. If the development
# flag is set but the target cannot be verified, selection fails closed rather
# than sending real SMS. In production the development flag is ignored.
#
# AUTH_SMS_PROVIDER="msg91"
# AUTH_SMS_TIMEOUT_MS="8000"
# AUTH_SMS_MESSAGE_TEMPLATE="Your TradePulse verification code is {code}. It is valid for {minutes} minutes. Do not share this code with anyone."
#
# MSG91 SendOTP. The template is created in the MSG91 dashboard with the OTP
# variable (##OTP##). India DLT entity, header, and template approval are also
# required in the MSG91 dashboard. `otp_expiry` is derived from
# AUTH_OTP_TTL_SECONDS and sent in minutes.
# AUTH_SMS_MSG91_AUTH_KEY="replace-with-msg91-auth-key"
# AUTH_SMS_MSG91_TEMPLATE_ID="replace-with-msg91-template-id"
#
# Twilio Programmable Messaging (Messages API). Use either a From number or a
# Messaging Service SID, never both. India DLT registration is required on the
# Twilio sender. A trial account can only send to verified recipient numbers.
# AUTH_SMS_TWILIO_ACCOUNT_SID="ACreplace-with-account-sid"
# AUTH_SMS_TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
# AUTH_SMS_TWILIO_FROM_NUMBER="+91XXXXXXXXXX"
# AUTH_SMS_TWILIO_MESSAGING_SERVICE_SID="MGreplace-with-messaging-service-sid"
#
# Exotel SMS API. Sender ID and both DLT identifiers are required for Indian
# destinations. The rendered message must match the approved DLT template
# exactly; only approved variables may change. Default subdomain is
# api.exotel.com (Mumbai: api.in.exotel.com).
# AUTH_SMS_EXOTEL_ACCOUNT_SID="replace-with-exotel-account-sid"
# AUTH_SMS_EXOTEL_API_KEY="replace-with-exotel-api-key"
# AUTH_SMS_EXOTEL_API_TOKEN="replace-with-exotel-api-token"
# AUTH_SMS_EXOTEL_SUBDOMAIN="api.exotel.com"
# AUTH_SMS_EXOTEL_SENDER_ID="TRDPLS"
# AUTH_SMS_EXOTEL_DLT_ENTITY_ID="replace-with-dlt-entity-id"
# AUTH_SMS_EXOTEL_DLT_TEMPLATE_ID="replace-with-dlt-template-id"
