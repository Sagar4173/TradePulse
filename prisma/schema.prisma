generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RETAILER
  SALESMAN
  ORDER_DESK
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SchemeType {
  BUY_X_GET_Y
  PERCENTAGE_DISCOUNT
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ON_CREDIT_HOLD
  REJECTED
  FULFILLED
  CANCELLED
}

enum OrderSource {
  MANUAL
  AI_TEXT
  AI_IMAGE
  AI_VOICE
  SALESMAN
}

enum OtpReservationStatus {
  PENDING
  CONSUMED
  FAILED
  ABANDONED
}

enum RetailerLinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String     @id @default(cuid())
  name            String
  phone           String     @unique
  /// Canonical E.164 identity used for lookups. Kept in sync on every write.
  phoneNormalized String     @unique
  email           String?
  role            UserRole
  status          UserStatus @default(ACTIVE)
  retailerId      String?
  phoneVerifiedAt DateTime?  @db.Timestamptz(3)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  retailer             Retailer?                    @relation(fields: [retailerId], references: [id], onDelete: SetNull)
  ordersCreated        Order[]                      @relation("OrderCreatedBy")
  auditEvents          AuditEvent[]                 @relation("AuditActor")
  sessions             Session[]
  assignedRetailers    SalesmanRetailerAssignment[] @relation("SalesmanAssignments")
  assignmentsCreated   SalesmanRetailerAssignment[] @relation("AssignmentCreator")
  retailerLinkRequests RetailerLinkRequest[]         @relation("RetailerLinkRequester")
  retailerLinkReviews  RetailerLinkRequest[]         @relation("RetailerLinkReviewer")

  @@index([retailerId])
  @@index([role])
  @@index([status])
}

model Retailer {
  id          String   @id @default(cuid())
  shopName    String
  ownerName   String
  phone       String
  creditLimit Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users               User[]
  prices              RetailerProductPrice[]
  orders              Order[]
  salesmanAssignments SalesmanRetailerAssignment[]
  linkRequests        RetailerLinkRequest[]

  @@index([shopName])
  @@index([phone])
}

model Product {
  sku         String   @id
  name        String
  description String?
  brand       String?  @db.VarChar(120)
  category    String?  @db.VarChar(80)
  imageUrl    String?  @db.VarChar(500)
  unitLabel   String
  dealerPrice Decimal  @db.Decimal(12, 2)
  gstRate     Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  inventory  Inventory?
  prices     RetailerProductPrice[]
  schemes    Scheme[]
  orderItems OrderItem[]

  @@index([isActive, name])
  @@index([isActive, category])
}

model RetailerProductPrice {
  id            String   @id @default(cuid())
  retailerId    String
  productSku    String
  sellingPrice  Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now()) @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productSku], references: [sku], onDelete: Cascade)

  @@unique([retailerId, productSku])
  @@index([productSku])
}

model Inventory {
  productSku    String   @id
  stockCases    Int      @default(0)
  reservedCases Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)
}

model Scheme {
  id              String     @id @default(cuid())
  name            String
  type            SchemeType
  isActive        Boolean    @default(true)
  startsAt        DateTime?  @db.Timestamptz(3)
  endsAt          DateTime?  @db.Timestamptz(3)
  minimumQuantity Int?
  freeQuantity    Int?
  discountPercent Decimal?   @db.Decimal(5, 2)
  productSku      String
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)

  @@index([productSku, isActive])
  @@index([isActive, startsAt, endsAt])
}

model Order {
  id          String      @id @default(cuid())
  retailerId  String
  createdById String
  status      OrderStatus @default(DRAFT)
  subtotal    Decimal     @default(0) @db.Decimal(14, 2)
  discount    Decimal     @default(0) @db.Decimal(14, 2)
  gstAmount   Decimal     @default(0) @db.Decimal(14, 2)
  total       Decimal     @default(0) @db.Decimal(14, 2)
  source      OrderSource
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  retailer  Retailer    @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  createdBy User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     OrderItem[]

  @@index([retailerId, createdAt])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productSku  String
  productName String
  unitLabel   String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  gstRate     Decimal  @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productSku], references: [sku], onDelete: Restrict)

  @@unique([orderId, productSku])
  @@index([productSku])
}

/// Admission lease for an OTP request. A reservation is created before the
/// expensive scrypt hash, counts toward the rate-limit window immediately, and
/// is completed only after the hashed challenge is persisted. Expired pending
/// reservations become ABANDONED and still count for the window, so a crashed
/// request cannot reset the limits.
model OtpRequestReservation {
  id            String               @id @default(cuid())
  phone         String
  requestIpHash String?
  status        OtpReservationStatus @default(PENDING)
  expiresAt     DateTime             @db.Timestamptz(3)
  completedAt   DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  challenge OtpChallenge?

  @@index([phone, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model OtpChallenge {
  id             String    @id @default(cuid())
  phone          String
  codeHash       String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  expiresAt      DateTime  @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  requestIpHash  String?
  reservationId  String?   @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  reservation OtpRequestReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  expiresAt     DateTime  @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  requestIpHash String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model SalesmanRetailerAssignment {
  id           String   @id @default(cuid())
  salesmanId   String
  retailerId   String
  assignedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  salesman   User     @relation("SalesmanAssignments", fields: [salesmanId], references: [id], onDelete: Cascade)
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([salesmanId, retailerId])
  @@index([retailerId])
  @@index([assignedById])
}

/// A phone-verified retailer account never links itself to an existing retailer
/// record. The match is recorded as a pending request and an administrator must
/// approve it explicitly. PostgreSQL enforces at most one PENDING request per
/// user/retailer pair through a partial unique index in the migration; past
/// decisions remain as history, so the pair itself is not globally unique.
model RetailerLinkRequest {
  id           String                    @id @default(cuid())
  userId       String
  retailerId   String
  status       RetailerLinkRequestStatus @default(PENDING)
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  reviewedAt   DateTime?                 @db.Timestamptz(3)
  reviewedById String?

  user       User     @relation("RetailerLinkRequester", fields: [userId], references: [id], onDelete: Restrict)
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  reviewedBy User?    @relation("RetailerLinkReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([userId, retailerId])
  @@index([status, createdAt])
  @@index([retailerId, status])
  @@index([reviewedById])
}

model AuditEvent {
  id         String   @id @default(cuid())
  eventType  String
  entityType String
  entityId   String
  actorId    String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@index([entityId])
}
